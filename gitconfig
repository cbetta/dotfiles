[user]
	name = Cristiano Betta
	email = cristiano@betta.io
	# The SSH key in 1Password, which also signs commits and tags
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEekqjaA2iulVyx83nmlRCMwRMRrrAzjukGje+rRWkv6
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = false
[core]
	editor = nvim
	excludesfile = ~/.gitignore
[credential]
	helper = osxkeychain
[url "https://github.com"]
	insteadOf = git://github.com
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
